---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectWindow from '../components/ProjectWindow.astro';
import { projects } from '../data/projects';
import { getVisiblePosts } from '../lib/posts';

const LATEST_POST_COUNT = 3;
const posts = await getVisiblePosts();
const postsFor = (slug: string) => posts.filter((post) => post.data.project === slug);
---

<BaseLayout title="Shivam Jaiswal" description="Full-stack engineer. Projects and design write-ups.">
  <section class="hero">
    <h1 class="display">
      full-stack engineer
      <span class="display-quiet">who writes down the decisions,<br />the trade-offs and what they cost</span>
    </h1>
    <p class="lead">
      I build products end to end, from Go and Python services to Angular and React front ends, and
      document every design choice before the code.
    </p>
    <div class="actions">
      <a class="button" href="/posts/">read the writing</a>
      <a class="text-link" href="#projects">see projects →</a>
    </div>
  </section>

  <section class="section" id="projects">
    <p class="eyebrow">projects</p>
    <h2 class="section-title">What I'm building</h2>
    <p class="muted">Source is private. Code walkthroughs available on request.</p>
    <div class="window-grid">
      {projects.map((project) => <ProjectWindow project={project} posts={postsFor(project.slug)} />)}
    </div>
  </section>

  <section class="section">
    <p class="eyebrow">writing</p>
    <h2 class="section-title">Latest</h2>
    <PostList posts={posts.slice(0, LATEST_POST_COUNT)} />
    <p><a class="text-link" href="/posts/">all posts →</a></p>
  </section>
</BaseLayout>
