---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import ProjectWindow from '../components/ProjectWindow.astro';
import { projects } from '../data/projects';
import { getVisiblePosts } from '../lib/posts';

const posts = await getVisiblePosts();
const postsFor = (slug: string) => posts.filter((post) => post.data.project === slug);
---

<BaseLayout
  title="Shivam Jaiswal"
  description="Full-stack engineer who designs for the breaks: failure modes, security, performance and UX."
>
  <section class="intro">
    <h1 class="display intro-title">
      Shivam Jaiswal
      <span class="display-quiet">full-stack engineer who designs for the breaks</span>
    </h1>
    <p class="lead">
      I write up how I design systems for failure, security, performance and cost, from
      Tracktions, a trading-journal SaaS I run alone, and artha-engine, a trading engine. Software
      engineer at BNY. <a href="/about/">About me →</a>
    </p>
  </section>

  <section class="section">
    <p class="eyebrow">writing</p>
    <PostList posts={posts} />
    <p><a class="text-link" href="/rss.xml">rss</a></p>
  </section>

  <section class="section" id="projects">
    <p class="eyebrow">projects</p>
    <h2 class="section-title">What I'm building</h2>
    <p class="muted">Source is private. Code walkthroughs available on request.</p>
    <div class="window-grid">
      {projects.map((project) => <ProjectWindow project={project} posts={postsFor(project.slug)} />)}
    </div>
  </section>
</BaseLayout>
