---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostList from '../../components/PostList.astro';
import { getVisiblePosts } from '../../lib/posts';

const posts = await getVisiblePosts();
---

<BaseLayout title="Writing" description="Design and technical write-ups: decisions, trade-offs and costs.">
  <section class="hero">
    <h1 class="display">
      writing
      <span class="display-quiet">decisions, trade-offs and costs</span>
    </h1>
  </section>
  <PostList posts={posts} />
</BaseLayout>
