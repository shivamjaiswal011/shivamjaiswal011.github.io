---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConcernTags from '../../components/ConcernTags.astro';
import { formatPostDate, getVisiblePosts, readMinutes, type Post } from '../../lib/posts';
import { projects } from '../../data/projects';

export async function getStaticPaths() {
  const posts = await getVisiblePosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props as { post: Post };
const { Content } = await render(post);
const project = projects.find((candidate) => candidate.slug === post.data.project);
---

<BaseLayout title={post.data.title} description={post.data.description}>
  <article class="article prose-column">
    <header class="article-header">
      <p class="eyebrow">
        <time datetime={post.data.published.toISOString()}>{formatPostDate(post.data.published)}</time>
        {project && <> · {project.name}</>}
        {' · '}{readMinutes(post)} min read
      </p>
      <h1 class="display">{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <ConcernTags keys={post.data.concerns} />
    </header>
    <div class="prose">
      <Content />
    </div>
    <p><a class="text-link" href="/posts/">← all posts</a></p>
  </article>
</BaseLayout>
