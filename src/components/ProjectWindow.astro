---
import type { Project } from '../data/projects';
import type { Post } from '../lib/posts';

interface Props {
  project: Project;
  posts: Post[];
}

const { project, posts } = Astro.props;
---

<article class="window">
  <div class="window-bar">
    <div class="window-dots" aria-hidden="true"><span></span><span></span><span></span></div>
    <span class="window-tab">{project.slug}</span>
  </div>
  <div class="window-body">
    <h3>{project.liveUrl ? <a href={project.liveUrl}>{project.name}</a> : project.name}</h3>
    <p>{project.summary}</p>
    <p class="mono muted">{project.role}</p>
    <ul class="stack" aria-label="Stack">
      {project.stack.map((tool) => <li>{tool}</li>)}
    </ul>
    {
      posts.length > 0 && (
        <ul class="window-posts">
          {posts.map((post) => (
            <li><a href={`/posts/${post.id}/`}>{post.data.title} →</a></li>
          ))}
        </ul>
      )
    }
  </div>
</article>
