---
import ConcernTags from './ConcernTags.astro';
import { formatPostDate, readMinutes, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="muted">First post coming soon.</p>}
{
  posts.length > 0 && (
    <ul class="post-list">
      {posts.map((post) => (
        <li>
          <a class="post-row" href={`/posts/${post.id}/`}>
            <time datetime={post.data.published.toISOString()}>{formatPostDate(post.data.published)}</time>
            <span class="post-row-title">
              {post.data.title}
              {post.data.draft && <span class="mono muted"> · draft</span>}
            </span>
            <span class="post-row-description">{post.data.description}</span>
            <span class="post-row-meta">
              <span class="mono muted">{readMinutes(post)} min read</span>
              <ConcernTags keys={post.data.concerns} />
            </span>
          </a>
        </li>
      ))}
    </ul>
  )
}
