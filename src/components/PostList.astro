---
import { formatPostDate, type Post } from '../lib/posts';

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{posts.length === 0 && <p class="muted">First post coming soon.</p>}
<ul class="list">
  {
    posts.map((post) => (
      <li>
        <a href={`/posts/${post.id}/`}>{post.data.title}</a>
        {post.data.draft && <strong> (draft)</strong>}
        <div class="muted">
          <time datetime={post.data.published.toISOString()}>{formatPostDate(post.data.published)}</time>
          {' · '}
          {post.data.description}
        </div>
      </li>
    ))
  }
</ul>
